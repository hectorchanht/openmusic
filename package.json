{
	"name": "openmusic",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:native": "BUILD_TARGET=native VITE_API_BASE=https://openmusic.lol vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "vitest --run",
		"gen": "wrangler types",
		"health": "node scripts/upstream-health.mjs",
		"cap:sync": "npx cap sync android",
		"apk": "pnpm build:native && npx cap sync android && cd android && ./gradlew assembleDebug",
		"deploy": "pnpm build && wrangler pages deploy .svelte-kit/cloudflare --project-name openmusic"
	},
	"devDependencies": {
		"@capacitor/android": "8.5.2",
		"@capacitor/cli": "8.5.2",
		"@cloudflare/workers-types": "4.20260605.1",
		"@sveltejs/adapter-cloudflare": "7.2.8",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.63.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"svelte": "5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "~5.9",
		"vite": "8.3.3",
		"vitest": "^4.1.3",
		"wrangler": "4.98.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	},
	"packageManager": "pnpm@8.15.5+sha1.a58c038faac410c947dbdb93eb30994037d0fce2",
	"dependencies": {
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "8.5.2",
		"@capacitor/filesystem": "8.1.4",
		"@capacitor/share": "^8.0.3",
		"@capacitor/splash-screen": "^8.0.2",
		"@capacitor/status-bar": "^8.0.4",
		"@jofr/capacitor-media-session": "4.0.0",
		"@lucide/svelte": "^1.52.0",
		"capacitor-blob-writer": "1.1.20",
		"taglib-wasm": "2.3.0",
		"tongwen-core": "4.1.1",
		"tongwen-dict": "1.0.2"
	}
}
