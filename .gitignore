# ===================== Node / SvelteKit / Cloudflare (Phase 1 rebuild) =====================
node_modules/
/.svelte-kit
/build
.output
.vercel
.netlify
.wrangler/

# Cloudflare local dev secrets — MUST stay out of git (JOOX token lives here)
.dev.vars
.dev.vars.*

# Vite timestamp artifacts
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ===================== Capacitor / Android (Phase 999.1 native) =====================
# Android build intermediates — only source (manifest, build.gradle, gradle wrapper)
# is committed; everything generated/build-time is ignored. android/ also ships its
# own Capacitor-generated .gitignore; these root entries are the belt-and-suspenders
# layer and add the signing-material patterns (NEVER commit keystores).
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/release/
# Capacitor copies the static web build into the platform on every sync — generated.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
*.apk
*.aab
*.keystore
*.jks

# ===================== Agent skills scratch =====================
# Local-markdown issue tracker used by the engineering skills (docs/agents/issue-tracker.md).
# Specs/tickets are working notes — local only, never committed.
.scratch/
