{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "openmusic",
	"compatibility_date": "2026-06-05",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	// PUBLIC ids that ship with every API URL by design (Jamendo client_id, Last.fm
	// optional key). For PRIVATE secrets (JOOX_TOKEN, LASTFM_SECRET) use
	// `wrangler pages secret put …` instead — vars in this file are baked into the
	// public Pages config. The Jamendo client_secret is intentionally NOT carried
	// here: it is only needed for OAuth flows we don't implement.
	// TURNSTILE_HOSTNAMES (quick-260926-nsz): hostnames a comment-post Turnstile token may be minted
	// on. Production only — localhost/127.0.0.1 live in .dev.vars and must NOT be added here. The
	// matching secret is TurnstileSecret (`wrangler pages secret put`, never a var).
	"vars": {
		"JAMENDO_CLIENT_ID": "1df0a42f",
		"TURNSTILE_HOSTNAMES": "openmusic.lol"
	},
	// Phase 33 / D-07 — diagnostics log store. Holds ONLY maintainer-uploaded activity logs;
	// both the write and the read path are bearer-token gated (D-01/D-02/D-03). The secrets
	// DIAG_UPLOAD_TOKEN / DIAG_READ_TOKEN are set with `wrangler pages secret put …` and are
	// NEVER listed as `vars` above (vars are baked into the public Pages config).
	// CAVEAT: `vars`, `kv_namespaces` and `r2_buckets` are NON-INHERITABLE. If anyone later adds
	// an `env.preview` block they must re-declare BOTH `vars` and `r2_buckets` inside it, or
	// JAMENDO_CLIENT_ID silently disappears from previews.
	// The bucket name must match the one created by Plan 06's human checkpoint exactly.
	"r2_buckets": [
		{
			"binding": "DIAG",
			"bucket_name": "openmusic-diag"
		}
	],
	// ANALYTICS (2026-10-10): anonymous play-count store. Holds ONLY play events
	// (anon random id + song id/title/artist/source + device/OS/platform/version/
	// locale/country + server timestamp); no IPs, no accounts. Written by
	// POST /api/analytics/play via the ANALYTICS_DB binding. Same wrangler.jsonc
	// pattern as the DIAG R2 binding above — applied by `wrangler pages deploy`.
	"d1_databases": [
		{
			"binding": "ANALYTICS_DB",
			"database_name": "openmusic-analytics",
			"database_id": "0c644f30-410a-4658-b184-9582077750e6"
		},
		// ACCOUNTS (quick-261020-acct): magic-link auth + cross-device sync store.
		// Holds PII (email addresses) + session/magic token hashes + the per-user
		// backup envelope — deliberately a SEPARATE database from the no-PII
		// openmusic-analytics above. Written/read by the /api/auth/* and
		// /api/me/sync routes via the ACCOUNTS_DB binding; the Pages secret is
		// RESEND_API_KEY (`wrangler pages secret put`, never a var).
		{
			"binding": "ACCOUNTS_DB",
			"database_name": "openmusic-accounts",
			"database_id": "16b53d6d-5ec1-46b9-97ec-69671b5f42fe"
		}
	]
}
